PORT=3000

# Jenkins machines the app can read from (first one is the default in the UI).
# For each <ID> below: API token (not your login password: Jenkins > your user > Configure > API Token),
# and the comma-separated host[:port] list the credentials may be sent to. The pasted build URL's host
# picks the platform, so every platform must list its hosts when more than one is configured.
JENKINS_PLATFORMS=SB,QA

# SB: master branch builds
JENKINS_SB_LABEL=SB
JENKINS_SB_USER=your.jenkins.username
JENKINS_SB_API_TOKEN=your-sb-jenkins-api-token
JENKINS_SB_ALLOWED_HOSTS=192.168.101.96:8080

# QA: QA branch builds
JENKINS_QA_LABEL=QA
JENKINS_QA_USER=your.jenkins.username
JENKINS_QA_API_TOKEN=your-qa-jenkins-api-token
JENKINS_QA_ALLOWED_HOSTS=192.168.101.105:8080

# Candidate relative paths (comma-separated) for the Cucumber JSON artifact within a Jenkins build.
# The first one found in the build's artifact list is used.
CUCUMBER_JSON_ARTIFACT_PATH=cucumber-report/cucumber.json,target/cucumber.json,reports/cucumber.json

JENKINS_REQUEST_TIMEOUT_MS=15000

# Build parameters that must match for an earlier build to be used for the new / recurring / fixed comparison.
# Parameterised jobs often run a different suite each build; this picks the latest earlier run of the same suite.
COMPARE_BUILD_PARAMS=Tags,Against,DataCenter,isRerun
